#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        tap_braces: tap_braces {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_BRACES";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE>, <&kp RIGHT_BRACE>;
        };

        tap_brackets: tap_brackets {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_BRACKETS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp RIGHT_BRACKET>;
        };

        tap_parens: tap_parens {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_PARENS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };
    };

    macros {
        mac_arrow: mac_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "MAC_ARROW";
        };

        mac_fat_arrow: mac_fat_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
            label = "MAC_FAT_ARROW";
        };

        mac_long_arrow: mac_long_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp EQUAL &kp GT>;
            label = "MAC_LONG_ARROW";
        };

        mac_tringle_operator: mac_tringle_operator {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PIPE &kp GREATER_THAN>;
            label = "MAC_TRINGLE_OPERATOR";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT  &none                                                                 &mo 3      &kp CARET  &kp AMPERSAND  &kp ASTERISK  &none      &none     &kp UNDERSCORE
&kp TAB    &kp Q            &kp W        &kp E     &kp R       &kp T        &none                                                                 &none      &kp Y      &kp U          &kp I         &kp O      &kp P     &kp BSLH
&kp ESC    &kp A            &kp S        &kp D     &kp F       &kp G        &none  &kp LCTRL  &kp LEFT_SHIFT      &kp RIGHT_SHIFT  &kp RCTRL      &none      &kp H      &kp J          &kp K         &kp L      &kp SEMI  &kp ENTER
&none      &kp Z            &kp X        &kp C     &kp V       &kp B                          &kp LEFT_ALT        &kp RIGHT_ALT                              &kp N      &kp M          &kp COMMA     &kp DOT    &kp FSLH  &none
&mo 2      &none            &none        &none     &none                    &mo 4  &mo 1      &kp TAB             &kp LEFT_META    &kp BACKSPACE  &kp SPACE             &kp LEFT       &kp UP_ARROW  &kp RIGHT  &kp DOWN  &to 5
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &trans  &trans  &trans  &trans         &trans             &trans                                             &trans     &trans           &mac_tringle_operator  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &trans
&trans  &trans  &trans  &trans  &tap_parens    &kp GRAVE          &trans                                             &trans     &mac_fat_arrow   &kp KP_N7              &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &trans
&trans  &trans  &trans  &trans  &tap_braces    &kp SINGLE_QUOTE   &trans  &trans  &trans      &trans  &trans         &trans     &mac_arrow       &kp KP_N4              &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &trans
&trans  &trans  &trans  &trans  &tap_brackets  &kp DOUBLE_QUOTES                  &trans      &trans                            &mac_long_arrow  &kp KP_N1              &kp KP_N2     &kp KP_N3      &kp KP_DOT       &trans
&trans  &trans  &trans  &trans  &trans                            &trans  &trans  &trans      &trans  &kp BACKSPACE  &kp KP_N0                   &trans                 &trans        &trans         &trans           &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &trans                                      &trans  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        shifted {
            bindings = <
&kp PLUS  &none      &none      &none      &none      &none      &trans                                                 &trans          &none      &none         &none             &none             &none         &kp MINUS
&trans    &kp LS(Q)  &kp LS(W)  &kp LS(E)  &kp LS(R)  &kp LS(T)  &trans                                                 &trans          &kp LS(Y)  &kp LS(U)     &kp LS(I)         &kp LS(O)         &kp LS(P)     &kp PIPE
&trans    &kp LS(A)  &kp LS(S)  &kp LS(D)  &kp LS(F)  &kp LS(G)  &trans  &trans  &trans      &trans  &trans             &trans          &kp LS(H)  &kp LS(J)     &kp LS(K)         &kp LS(L)         &kp COLON     &kp LS(ENTER)
&trans    &kp LS(Z)  &kp LS(X)  &kp LS(C)  &kp LS(V)  &kp LS(B)                  &trans      &trans                                     &kp LS(N)  &kp LS(M)     &kp LESS_THAN     &kp GREATER_THAN  &kp QUESTION  &trans
&trans    &kp TILDE  &trans     &trans     &trans                &trans  &trans  &trans      &trans  &kp LC(BACKSPACE)  &kp UNDERSCORE             &kp LS(LEFT)  &kp LS(UP_ARROW)  &kp LS(RIGHT)     &kp LS(DOWN)  &trans
            >;

            label = "shifted";
        };

        games {
            bindings = <
&kp ESC    &kp N1    &kp N2  &kp N3  &kp N4  &kp N5  &kp N6                                       &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB    &kp Q     &kp W   &kp E   &kp R   &kp T   &kp Y                                        &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp BSLH   &kp A     &kp S   &kp D   &kp F   &kp G   &kp H      &kp U  &kp I      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &kp Z     &kp X   &kp C   &kp V   &kp B                     &kp K      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &kp LALT  &kp N7  &kp N8  &kp N9          &kp SPACE  &kp J  &kp M      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &to 0
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
